# Auto-detect text files, normalize to LF in the repo
* text=auto

# Source code: LF mandatory
*.c    text eol=lf
*.h    text eol=lf
*.s    text eol=lf
*.ld   text eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.ico  binary
*.bin  binary
*.hex  binary
